/* =========================
   GLOBAL
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: #172033;
    background: #ffffff;
    line-height: 1.6;
}

a {
    text-decoration: none;
    color: inherit;
}

img {
    max-width: 100%;
    display: block;
}

.container {
    width: min(1120px, 90%);
    margin: auto;
}


/* =========================
   NAVBAR
========================= */

.header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid #edf0f5;
}

.navbar {
    min-height: 75px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 24px;
    font-weight: 800;
    color: #172033;
}

.logo span {
    color: #4776e6;
}

.nav-links {
    display: flex;
    gap: 30px;
    list-style: none;
}

.nav-links a {
    font-size: 15px;
    font-weight: 600;
    color: #5d6678;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #4776e6;
}

.menu-toggle {
    display: none;
    border: none;
    background: none;
    font-size: 28px;
    cursor: pointer;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 650px;
    display: flex;
    align-items: center;
    background:
        radial-gradient(circle at 85% 20%, #dce8ff 0, transparent 30%),
        linear-gradient(135deg, #f6f9ff, #ffffff);
}

.hero-content {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 60px;
}

.tagline,
.section-heading p {
    color: #4776e6;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    margin-bottom: 15px;
}

.hero h1 {
    font-size: clamp(42px, 6vw, 68px);
    line-height: 1.08;
    margin-bottom: 25px;
}

.hero h1 span {
    color: #4776e6;
}

.hero-description {
    max-width: 580px;
    color: #657086;
    font-size: 18px;
    margin-bottom: 35px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    display: inline-block;
    padding: 13px 25px;
    border-radius: 8px;
    font-weight: 700;
    transition: 0.3s;
}

.primary-btn {
    color: white;
    background: #4776e6;
    box-shadow: 0 10px 25px rgba(71, 118, 230, 0.25);
}

.primary-btn:hover {
    transform: translateY(-3px);
    background: #345fc5;
}

.secondary-btn {
    color: #4776e6;
    background: white;
    border: 1px solid #dce4f5;
}

.secondary-btn:hover {
    background: #f0f4ff;
}

.hero-image {
    display: flex;
    justify-content: center;
}

.hero-image img {
    width: min(500px, 100%);
    animation: float 4s ease-in-out infinite;
}

@keyframes float {
    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-12px);
    }
}


/* =========================
   SECTIONS
========================= */

.section {
    padding: 100px 0;
}

.section-heading {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 55px;
}

.section-heading h2 {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.2;
}


/* =========================
   ABOUT
========================= */

.about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 60px;
    align-items: center;
}

.about-text > p {
    color: #687286;
    margin-bottom: 20px;
    font-size: 17px;
}

.stats {
    display: flex;
    gap: 40px;
    margin-top: 35px;
}

.stat {
    display: flex;
    flex-direction: column;
}

.stat strong {
    color: #4776e6;
    font-size: 28px;
}

.stat span {
    color: #737c8e;
    font-size: 14px;
}

.info-card {
    padding: 40px;
    border-radius: 20px;
    background: #f3f7ff;
    border: 1px solid #dfe8ff;
}

.cloud-icon {
    font-size: 55px;
    margin-bottom: 15px;
}

.info-card h3 {
    font-size: 25px;
    margin-bottom: 12px;
}

.info-card p {
    color: #687286;
}


/* =========================
   SERVICES
========================= */

.services-section {
    background: #f7f9fd;
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.card {
    position: relative;
    background: white;
    padding: 35px;
    border-radius: 16px;
    border: 1px solid #e9edf4;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(40, 65, 110, 0.1);
}

.featured-card {
    border: 2px solid #4776e6;
}

.popular {
    position: absolute;
    top: 18px;
    right: 18px;
    background: #4776e6;
    color: white;
    padding: 4px 9px;
    border-radius: 20px;
    font-size: 10px;
    font-weight: bold;
}

.card-icon {
    font-size: 40px;
    margin-bottom: 20px;
}

.card h3 {
    font-size: 28px;
    color: #4776e6;
}

.card h4 {
    margin: 5px 0 15px;
}

.card p {
    color: #6c7587;
    margin-bottom: 25px;
}

.card-link {
    color: #4776e6;
    font-weight: bold;
}


/* =========================
   DEPLOYMENT MODELS
========================= */

.model-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.model-card {
    padding: 30px;
    border-radius: 14px;
    background: #ffffff;
    border: 1px solid #e5eaf2;
    transition: 0.3s;
}

.model-card:hover {
    border-color: #4776e6;
    transform: translateY(-5px);
}

.model-card span {
    color: #4776e6;
    font-size: 13px;
    font-weight: bold;
}

.model-card h3 {
    margin: 15px 0 10px;
}

.model-card p {
    color: #6c7587;
    font-size: 14px;
}


/* =========================
   BENEFITS
========================= */

.benefits {
    padding: 90px 0;
    color: white;
    background: linear-gradient(135deg, #4776e6, #294fa8);
}

.benefits-content {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 70px;
    align-items: center;
}

.benefits h2 {
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.15;
}

.benefits .tagline {
    color: #c9d9ff;
}

.benefit-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
}

.benefit-list div {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.1);
}

.benefit-list span {
    color: #bcd1ff;
    font-size: 20px;
    font-weight: bold;
}


/* =========================
   PROVIDERS
========================= */

.provider-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.provider {
    text-align: center;
    padding: 40px 25px;
    border: 1px solid #e6ebf2;
    border-radius: 16px;
    transition: 0.3s;
}

.provider:hover {
    transform: translateY(-6px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.07);
}

.provider img {
    height: 65px;
    width: 100%;
    object-fit: contain;
    margin: 0 auto 20px;
}

.provider h3 {
    margin-bottom: 10px;
}

.provider p {
    color: #6c7587;
}


/* =========================
   CTA
========================= */

.cta {
    text-align: center;
    padding: 90px 20px;
    background: #eef4ff;
}

.cta h2 {
    font-size: 42px;
    margin-bottom: 15px;
}

.cta p {
    color: #687286;
    margin-bottom: 30px;
}

.white-btn {
    color: #4776e6;
    background: white;
    box-shadow: 0 8px 20px rgba(71, 118, 230, 0.12);
}


/* =========================
   FOOTER
========================= */

footer {
    padding: 35px 0;
    background: #111827;
    color: white;
}

.footer-content {
    display: flex;
    justify-content: space-between;
    gap: 30px;
}

footer p {
    color: #9ca8bb;
    font-size: 13px;
    margin-top: 8px;
}


/* =========================
   TOP BUTTON
========================= */

.top-button {
    position: fixed;
    right: 25px;
    bottom: 25px;

    width: 45px;
    height: 45px;

    border: none;
    border-radius: 50%;

    background: #4776e6;
    color: white;

    font-size: 20px;
    cursor: pointer;

    opacity: 0;
    pointer-events: none;

    transition: 0.3s;
}

.top-button.show {
    opacity: 1;
    pointer-events: auto;
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 900px) {

    .nav-links {
        position: absolute;
        top: 75px;
        left: 0;
        width: 100%;

        display: none;
        flex-direction: column;

        padding: 25px;

        background: white;
        border-bottom: 1px solid #e8ecf2;
    }

    .nav-links.active {
        display: flex;
    }

    .menu-toggle {
        display: block;
    }

    .hero-content,
    .about-grid,
    .benefits-content {
        grid-template-columns: 1fr;
    }

    .hero {
        padding: 80px 0;
    }

    .hero-image {
        order: -1;
    }

    .cards,
    .provider-grid {
        grid-template-columns: 1fr 1fr;
    }

    .model-grid {
        grid-template-columns: 1fr 1fr;
    }
}


@media (max-width: 600px) {

    .section {
        padding: 70px 0;
    }

    .hero h1 {
        font-size: 42px;
    }

    .hero-description {
        font-size: 16px;
    }

    .cards,
    .provider-grid,
    .model-grid {
        grid-template-columns: 1fr;
    }

    .stats {
        gap: 20px;
        justify-content: space-between;
    }

    .benefit-list {
        grid-template-columns: 1fr;
    }

    .footer-content {
        flex-direction: column;
    }

    .cta h2 {
        font-size: 32px;
    }
}

